<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram name="1. Sơ đồ màn hình" id="sitemap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Phòng khám Nấm yêu — Sơ đồ màn hình tổng quan" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Next.js (web, cổng 3000) → Node.js API (cổng 4000) → PostgreSQL phong_kham_nam_yeu. Màu ô = tác nhân dùng màn hình (xem chú giải)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/></mxCell><mxCell id="login" value="&lt;b style=&quot;font-size:12px&quot;&gt;Đăng nhập&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/login&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC00&lt;/i&gt;&lt;br&gt;• Tên đăng nhập + mật khẩu&lt;br&gt;• Phân quyền theo vai trò&lt;br&gt;&lt;b&gt;Mọi nhân viên&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="210" height="100" as="geometry"/></mxCell><mxCell id="home" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tổng quan&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/&lt;/font&gt;&lt;br&gt;&lt;i&gt;Dashboard&lt;/i&gt;&lt;br&gt;• Lịch hẹn hôm nay&lt;br&gt;• Cảnh báo tồn kho (UC25)&lt;br&gt;• Đã thu hôm nay / công nợ (LT, QL)&lt;br&gt;&lt;b&gt;Mọi nhân viên — BS chỉ thấy lịch của mình&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="290" height="120" as="geometry"/></mxCell><mxCell id="pwd" value="&lt;b style=&quot;font-size:12px&quot;&gt;Đổi mật khẩu&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/doi-mat-khau&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC00&lt;/i&gt;&lt;br&gt;• Mật khẩu cũ / mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="200" height="80" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Tác nhân Hệ thống (Timer)&lt;/b&gt;&lt;br&gt;• UC25: trigger DB tự mở / đóng cảnh báo khi tồn kho &amp;lt; ngưỡng&lt;br&gt;• UC26: server chạy fn_archive_expired_patients() mỗi ngày — khóa hồ sơ quá 5 năm, chặn xóa hồ sơ chưa đủ 5 năm" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="380" height="100" as="geometry"/></mxCell><mxCell id="e_login" value="đăng nhập" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="login" target="home"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_pwd" value="menu tài khoản" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="home" target="pwd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gA" value="A–C. Tiếp đón, lịch hẹn &amp; khám điều trị" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=#0f766e;swimlaneFillColor=#fbfcfc;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="860" height="560" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b style=&quot;font-size:12px&quot;&gt;Lịch hẹn&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/lich-hen&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC05 · UC06 · UC07 · UC08&lt;/i&gt;&lt;br&gt;• Lưới: cột = ghế, hàng = khung 30 phút&lt;br&gt;• Bác sĩ trực trong ngày (UC05b)&lt;br&gt;• Bấm ô trống → đặt lịch&lt;br&gt;• Danh sách lịch đã hủy + lý do&lt;br&gt;&lt;b&gt;LT: đặt / đổi / hủy · BS: xem, bắt đầu khám&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="20" y="45" width="250" height="160" as="geometry"/></mxCell><mxCell id="record" value="&lt;b style=&quot;font-size:12px&quot;&gt;Phiếu điều trị&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/phieu-dieu-tri/[id]&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC09 · UC10 · UC11 · UC12&lt;/i&gt;&lt;br&gt;• Cảnh báo dị ứng&lt;br&gt;• Việc làm: dịch vụ, số răng FDI, BS thực hiện (QĐ1)&lt;br&gt;• Đơn thuốc · Vật tư (trừ kho)&lt;br&gt;• Lịch sử sửa: ai, lúc nào, trước/sau&lt;br&gt;&lt;b&gt;BS: ghi / sửa · LT: xem, lập hóa đơn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="300" y="45" width="250" height="160" as="geometry"/></mxCell><mxCell id="plans" value="&lt;b style=&quot;font-size:12px&quot;&gt;Liệu trình&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/lieu-trinh&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC13 · UC14&lt;/i&gt;&lt;br&gt;• Lọc: đang điều trị / hoàn thành / hủy&lt;br&gt;• Thanh tiến độ: đã làm / còn lại&lt;br&gt;• Đã thu / tổng tiền&lt;br&gt;&lt;b&gt;BS: lập liệu trình · LT: xem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="580" y="45" width="250" height="160" as="geometry"/></mxCell><mxCell id="patients" value="&lt;b style=&quot;font-size:12px&quot;&gt;Bệnh nhân&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/benh-nhan&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC01 · UC02&lt;/i&gt;&lt;br&gt;• Tìm theo SĐT hoặc tên&lt;br&gt;• Nhóm theo SĐT: 1 SĐT → nhiều BN (QĐ2)&lt;br&gt;• Đăng ký mới (tra SĐT trước)&lt;br&gt;&lt;b&gt;LT: đăng ký · BS: tra cứu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="20" y="230" width="250" height="150" as="geometry"/></mxCell><mxCell id="patient" value="&lt;b style=&quot;font-size:12px&quot;&gt;Hồ sơ bệnh nhân&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/benh-nhan/[id]&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC03 · UC04&lt;/i&gt;&lt;br&gt;• Thông tin, dị ứng, dùng chung SĐT&lt;br&gt;• Tab: lịch sử khám · lịch hẹn · liệu trình · hóa đơn&lt;br&gt;• Sửa hồ sơ (khóa nếu đã lưu trữ)&lt;br&gt;&lt;b&gt;LT: sửa · BS: xem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="300" y="230" width="250" height="150" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b style=&quot;font-size:12px&quot;&gt;Chi tiết liệu trình&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/lieu-trinh/[id]&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC14 · UC18&lt;/i&gt;&lt;br&gt;• Các đợt thanh toán + đã thu&lt;br&gt;• Các buổi đã làm&lt;br&gt;• Ghi buổi mới · hoàn thành / hủy&lt;br&gt;&lt;b&gt;BS: ghi buổi · LT: lập HĐ liệu trình&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gA"><mxGeometry x="580" y="230" width="250" height="150" as="geometry"/></mxCell><mxCell id="mBook" value="&lt;b&gt;Modal Đặt lịch&lt;/b&gt; (UC05)&lt;br&gt;• Chọn BN (tìm SĐT) · ngày · giờ&lt;br&gt;• BS (đánh dấu ✓ trực) · ghế · dịch vụ&lt;br&gt;• DB chặn trùng ghế / BS / ngoài ca" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;dashed=1;fillColor=#ffffff;strokeColor=#777777;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="gA"><mxGeometry x="20" y="410" width="250" height="100" as="geometry"/></mxCell><mxCell id="mAppt" value="&lt;b&gt;Modal Chi tiết lịch hẹn&lt;/b&gt;&lt;br&gt;• Đổi lịch (UC06) · Hủy + lý do (UC07)&lt;br&gt;• Không đến · Bắt đầu khám (BS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;dashed=1;fillColor=#ffffff;strokeColor=#777777;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="gA"><mxGeometry x="300" y="410" width="250" height="100" as="geometry"/></mxCell><mxCell id="mPlan" value="&lt;b&gt;Modal Lập liệu trình&lt;/b&gt; (UC13)&lt;br&gt;• Tên, số buổi, tổng tiền&lt;br&gt;• Chia đợt: tổng các đợt = tổng tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;dashed=1;fillColor=#ffffff;strokeColor=#777777;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="gA"><mxGeometry x="580" y="410" width="250" height="100" as="geometry"/></mxCell><mxCell id="gD" value="D. Thanh toán" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=#0f766e;swimlaneFillColor=#fbfcfc;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="380" height="560" as="geometry"/></mxCell><mxCell id="invoices" value="&lt;b style=&quot;font-size:12px&quot;&gt;Hóa đơn &amp;amp; công nợ&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/hoa-don&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC15 · UC19&lt;/i&gt;&lt;br&gt;• Tab Chờ lập hóa đơn (phiếu còn việc chưa tính tiền)&lt;br&gt;• Tab Hóa đơn (lọc còn nợ)&lt;br&gt;• Tab Công nợ theo bệnh nhân&lt;br&gt;&lt;b&gt;LT: lập HĐ · QL: xem công nợ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#d0efe9;strokeColor=#0f766e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gD"><mxGeometry x="30" y="45" width="320" height="150" as="geometry"/></mxCell><mxCell id="invoice" value="&lt;b style=&quot;font-size:12px&quot;&gt;Chi tiết hóa đơn&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/hoa-don/[id]&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC15 · UC16 · UC17 · UC18&lt;/i&gt;&lt;br&gt;• Dòng dịch vụ: giá đã chốt, BS thực hiện&lt;br&gt;• Giảm giá từng dòng / trên tổng → phân bổ (QĐ3)&lt;br&gt;• Thu nhiều lần: tiền mặt / chuyển khoản&lt;br&gt;• Thu theo đợt liệu trình&lt;br&gt;• Hủy HĐ khi chưa thu&lt;br&gt;&lt;b&gt;LT: thao tác · QL: xem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#d0efe9;strokeColor=#0f766e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gD"><mxGeometry x="30" y="230" width="320" height="170" as="geometry"/></mxCell><mxCell id="nInv" value="Hóa đơn được lập từ:&lt;br&gt;• Phiếu điều trị (tự thêm các việc chưa tính tiền)&lt;br&gt;• Liệu trình (trọn gói, thu theo đợt)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="gD"><mxGeometry x="30" y="430" width="320" height="80" as="geometry"/></mxCell><mxCell id="gE" value="E–F. Danh mục, kho &amp; báo cáo (Quản lý)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=#0f766e;swimlaneFillColor=#fbfcfc;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1280" height="240" as="geometry"/></mxCell><mxCell id="services" value="&lt;b style=&quot;font-size:12px&quot;&gt;Dịch vụ &amp;amp; bảng giá&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/danh-muc/dich-vu&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC20&lt;/i&gt;&lt;br&gt;• Thêm / sửa / ngưng dịch vụ&lt;br&gt;• Giá mới từ ngày X, tự đóng giá cũ&lt;br&gt;• Lịch sử giá" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="20" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="shifts" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ca trực bác sĩ&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/danh-muc/ca-truc&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC21&lt;/i&gt;&lt;br&gt;• Lưới tuần: bác sĩ × ngày&lt;br&gt;• Tạo hàng loạt theo thứ&lt;br&gt;• Chặn ca chồng giờ, chặn xóa ca còn lịch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="228" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="chairs" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ghế nha khoa&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/danh-muc/ghe&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC22&lt;/i&gt;&lt;br&gt;• Thêm / sửa ghế&lt;br&gt;• Ngưng dùng → ẩn khỏi lưới lịch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="436" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b style=&quot;font-size:12px&quot;&gt;Nhân viên&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/nhan-vien&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC23&lt;/i&gt;&lt;br&gt;• Thêm / sửa, vai trò&lt;br&gt;• Khóa tài khoản, đặt lại mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="644" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="stock" value="&lt;b style=&quot;font-size:12px&quot;&gt;Thuốc &amp;amp; vật tư&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/kho&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC24 · UC25&lt;/i&gt;&lt;br&gt;• Danh mục, tồn, ngưỡng&lt;br&gt;• Phiếu nhập kho (+ tồn)&lt;br&gt;• Cảnh báo dưới ngưỡng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="852" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b style=&quot;font-size:12px&quot;&gt;Báo cáo&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;/bao-cao&lt;/font&gt;&lt;br&gt;&lt;i&gt;UC27.1 – 27.8&lt;/i&gt;&lt;br&gt;• 8 tab: doanh thu BS, ghế trống,&lt;br&gt;• BN quá 6 tháng, hủy lịch, công nợ,&lt;br&gt;• liệu trình dở, sắp hết, % tháng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="gE"><mxGeometry x="1060" y="45" width="195" height="170" as="geometry"/></mxCell><mxCell id="n1" value="Mở lịch hẹn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="home" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="ô trống" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="sched" target="mBook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n3" value="bấm lịch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="sched" target="mAppt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" value="Bắt đầu khám (BS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mAppt" target="record"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="chọn BN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patients" target="patient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="Đặt lịch hẹn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="Lịch sử khám" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="record"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="chọn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=blo
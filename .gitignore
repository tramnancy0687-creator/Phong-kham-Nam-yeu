# Bí mật (mật khẩu, JWT secret) — không đưa vào Git
.env
.env.*
!.env.example
!.env.*.example
# Chỉ chứa địa chỉ backend, không có bí mật
!web/.env.production

# Thư mục liên kết project của Vercel CLI
.vercel/

# Thư viện và bản build (tạo lại được bằng npm install / next build)
node_modules/
.next/
out/

# Cài đặt cá nhân của Claude Code, log
.claude/settings.local.json
*.log

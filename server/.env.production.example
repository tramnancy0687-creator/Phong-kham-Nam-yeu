# Cấu hình production — copy thành .env.production rồi điền giá trị thật (file đó KHÔNG đưa lên Git)
# Trên nền tảng hosting (Render, Railway…) thì nhập các biến này ở mục Environment Variables thay cho file.
NODE_ENV=production
PORT=4000

# Chuỗi kết nối Neon: Dashboard → Connect → copy "Connection string" (bản Pooled connection)
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full&channel_binding=require

# Số kết nối tối đa từ server tới DB (gói free nên để nhỏ)
DB_POOL_MAX=5

# Chuỗi ngẫu nhiên dài, KHÁC với bản local. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
